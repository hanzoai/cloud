# syntax=docker/dockerfile:1
# Backend-only hotfix build for the per-org Square processor fix.
#
# Mirrors the Go build + runtime stages of the main Dockerfile, but:
#   * skips the Node admin-SPA stage (the go:embed target is the committed
#     ui/dist bundle; admin/dist is an optional overlay, not required), and
#   * mounts a GitHub token secret so `go mod download` can fetch the
#     private luxfi/* and hanzoai/* modules referenced in go.mod.
#
# Build with:
#   docker buildx build --platform linux/amd64 \
#     --secret id=gh_token,env=GH_TOKEN \
#     -t <tag> --push -f Dockerfile.sqfix .

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev curl

ARG TARGETARCH
WORKDIR /build

ENV GOPRIVATE=github.com/hanzoai,github.com/luxfi,github.com/zooai,github.com/zenlm,github.com/parsdao,github.com/adnexustech
# Disable workspace mode: the repo ships a go.work (use . + ./thirdparty/ethereum)
# that would force readonly/vendor; we build the single commerce module non-vendored.
ENV GOWORK=off

# Copy go module files first for layer caching.
COPY go.mod go.sum ./

# Download dependencies using the mounted GitHub token for private repos.
RUN --mount=type=secret,id=gh_token \
    --mount=type=cache,target=/go/pkg/mod \
    git config --global url."https://x-access-token:$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    go mod download && \
    git config --global --unset url."https://x-access-token:$(cat /run/secrets/gh_token)@github.com/".insteadOf || true

# Copy the full source tree (includes committed ui/dist embed bundle).
COPY . .

# Populate api/billing/plans/*.json — gitignored (@hanzo/plans is the SOT,
# fetched from the public npm tarball at build time), so absent from the git
# build context. api/billing/plans.go go:embed's plans/dns.json +
# plans/subscription.json at compile time, so this MUST run before `go build`.
# Mirrors the main Dockerfile; public npm, no auth.
RUN sh scripts/fetch-plans.sh

ARG GO_EXPERIMENT=jsonv2
ENV GOEXPERIMENT=${GO_EXPERIMENT}

# VERSION injected by CI from the immutable image tag (see Dockerfile).
ARG VERSION=""

# Build the binary with CGO for SQLite support. Match the main Dockerfile:
# -tags cloud, same ldflags shape. Non-vendored so luxfi/accel resolves its
# out-of-package C headers (include/lux/accel/c_api.h) from the module cache.
RUN --mount=type=secret,id=gh_token \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    git config --global url."https://x-access-token:$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    VER="${VERSION#v}" && \
    CGO_ENABLED=1 GOMAXPROCS=1 GOOS=linux GOARCH=${TARGETARCH} go build -p=1 \
    -tags cloud \
    -ldflags="-s -w \
      ${VER:+-X github.com/hanzoai/commerce.Version=${VER}} \
      -X github.com/hanzoai/commerce.GitCommit=$(git rev-parse --short HEAD 2>/dev/null || echo sqfix) \
      -X github.com/hanzoai/commerce.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /build/commerce \
    ./cmd/commerce

# Production stage — identical to the main Dockerfile.
FROM alpine:3.21

LABEL org.opencontainers.image.source="https://github.com/hanzoai/commerce"

RUN apk add --no-cache ca-certificates tzdata curl
RUN addgroup -S hanzo && adduser -S hanzo -G hanzo

WORKDIR /app

COPY --from=builder /build/commerce /app/commerce
COPY --from=builder /build/templates /app/templates
COPY --from=builder /build/api/templates /app/api/templates

RUN mkdir -p /app/data /app/logs && \
    chown -R hanzo:hanzo /app

USER hanzo

EXPOSE 8001

ENV COMMERCE_DIR=/app/data
ENV COMMERCE_DEV=false
ENV PORT=8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/healthz || exit 1

ENTRYPOINT ["/app/commerce"]
CMD ["--http", "0.0.0.0:8001"]
