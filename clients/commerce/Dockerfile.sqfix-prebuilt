# syntax=docker/dockerfile:1
# Packages the zig-cross-compiled linux/amd64 commerce binary into the
# production runtime image. The binary is built on the host with:
#   CC="zig cc -target x86_64-linux-musl" CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
#     go build -tags cloud -ldflags="-s -w -extldflags '-static'" \
#     -o commerce.amd64 ./cmd/commerce
# Entrypoint/CMD match the main Dockerfile (--http 0.0.0.0:8001) so this is a
# drop-in replacement for the running deployment's image.

FROM alpine:3.21

LABEL org.opencontainers.image.source="https://github.com/hanzoai/commerce"

RUN apk add --no-cache ca-certificates tzdata curl
RUN addgroup -S hanzo && adduser -S hanzo -G hanzo

WORKDIR /app

# Pre-built static binary + runtime assets (templates).
COPY commerce.amd64 /app/commerce
COPY templates /app/templates
COPY api/templates /app/api/templates

RUN chmod +x /app/commerce && \
    mkdir -p /app/data /app/logs && \
    chown -R hanzo:hanzo /app

USER hanzo

EXPOSE 8001

ENV COMMERCE_DIR=/app/data
ENV COMMERCE_DEV=false
ENV PORT=8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/healthz || exit 1

ENTRYPOINT ["/app/commerce"]
CMD ["--http", "0.0.0.0:8001"]
