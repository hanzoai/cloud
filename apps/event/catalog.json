  "products": ["site","app","chat","console","admin","cloud","id","billing","pay","commerce"],
  "funnels": {
    "signup": {"label":"Signup","products":["site","id"],"join":"aggregate","steps":[{"event":"$pageview","label":"Landed","product":"site"},{"event":"signup_viewed","label":"Opened signup","product":"site"},{"event":"signup_submitted","label":"Redirected to Hanzo ID","product":"site"},{"event":"signup_viewed","label":"Saw the form","product":"id"},{"event":"signup_submitted","label":"Submitted the form","product":"id"},{"event":"signup_completed","label":"Account created","product":"site"}]},
    "journey": {"label":"Hanzo journey","products":["site","app","chat","pay","commerce"],"join":"person","steps":[{"event":"$pageview","label":"Landed"},{"event":"signup_viewed","label":"Saw sign-up"},{"event":"signup_submitted","label":"Asked for an account"},{"event":"signup_completed","label":"Account created"},{"event":"usage_selected","label":"Said how they will use Hanzo"},{"event":"pricing_viewed","label":"Saw plans"},{"event":"plan_clicked","label":"Pressed a plan"},{"event":"plan_selected","label":"Opened checkout on a plan"},{"event":"checkout_started","label":"Saw the billing form","product":"pay"},{"event":"payment_info_added","label":"Card tokenized"},{"event":"order_completed","label":"Paid"},{"event":"first_action","label":"First action"}]},
    "apiActivation": {"label":"API activation","products":["site","cloud"],"join":"person","steps":[{"event":"signup_completed","label":"Account created"},{"event":"api_key_created","label":"Key minted"},{"event":"first_action","label":"First successful API call","where":{"property":"action","equals":"api_call"}}]},
    "upgrade": {"label":"Upgrade","products":["site","app","console","pay"],"join":"person","steps":[{"event":"pricing_viewed","label":"Viewed pricing"},{"event":"plan_clicked","label":"Chose a plan"},{"event":"checkout_started","label":"Reached the card form","product":"pay"},{"event":"order_completed","label":"Paid"}]},
    "checkout": {"label":"Checkout, signed out","products":["pay"],"join":"person","steps":[{"event":"checkout_viewed","label":"Saw the plan and its price","product":"pay"},{"event":"checkout_started","label":"Signed in at the card form","product":"pay"},{"event":"order_completed","label":"Paid"}]},
    "appShip": {"label":"Describe → ship","products":["app"],"join":"person","steps":[{"event":"$pageview","label":"Landed"},{"event":"build_started","label":"Described an app"},{"event":"generation_completed","label":"Got a working build"},{"event":"deploy_started","label":"Hit publish"},{"event":"deploy_succeeded","label":"Live URL"}]},
    "chatEngage": {"label":"Chat engagement","products":["chat"],"join":"person","steps":[{"event":"$pageview","label":"Landed"},{"event":"chat_started","label":"Started a conversation"},{"event":"chat_message_sent","label":"Sent a message"},{"event":"generation_completed","label":"Got an answer"}]},
    "siteToChat": {"label":"Site → Chat handoff","products":["site","chat"],"join":"aggregate","steps":[{"event":"chat_started","label":"Submitted the hanzo.ai composer","product":"site","where":{"property":"source","equals":"composer"}},{"event":"chat_started","label":"Landed in hanzo.chat","product":"chat","where":{"property":"referrerProduct","equals":"site"}},{"event":"generation_completed","label":"Got an answer"}]}
  }
}
