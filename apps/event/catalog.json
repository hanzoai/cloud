{
  "version": 3,
  "names": ["signup_viewed","signup_submitted","signup_verified","signup_completed","login_completed","logout_completed","signin_failed","first_action","waitlist_joined","waitlist_shared","referral_used","referral_claimed","pricing_viewed","plan_clicked","plan_selected","plan_skipped","plan_changed","upgrade_clicked","checkout_viewed","checkout_started","payment_info_added","checkout_abandoned","checkout_failed","order_completed","subscription_changed","subscription_canceled","order_refunded","sales_contacted","product_viewed","search_performed","cta_clicked","newsletter_subscribed","beta_submitted","research_access_applied","usage_selected","team_created","first_chat_notice_accepted","name_set","role_selected","starter_prompt_used","own_topic_chosen","feature_used","api_key_created","app_created","project_created","agent_created","chat_started","chat_message_sent","model_switched","task_started","task_completed","build_started","generation_completed","generation_failed","deploy_started","deploy_succeeded","deploy_failed"],
  "reserved": ["$pageview","$exception"],
  "schema": {
    "signup_viewed": {"summary":"The signup form was shown.","props":{}},
    "signup_submitted": {"summary":"The signup form was submitted.","props":{}},
    "signup_verified": {"summary":"The address on a signup was verified.","props":{}},
    "signup_completed": {"summary":"A new account exists and is usable.","props":{}},
    "login_completed": {"summary":"A RETURNING user authenticated. Distinct from signup_completed on purpose — folding the two makes every returning login inflate the signup count.","props":{}},
    "logout_completed": {"summary":"The session ended and the visitor is signed out.","props":{}},
    "signin_failed": {"summary":"A sign-in or sign-up was refused, counted by the kind of refusal and never by its words.","props":{"reason":{"type":"string","doc":"IAM's code for the refusal, else the error's class; never a sentence."},"method":{"type":"string","doc":"The way in: a provider, email, phone or wallet."},"step":{"type":"string","doc":"The step of the sign-in it was refused at."},"mode":{"type":"string","doc":"Whether it was a sign-up or a sign-in.","values":["signup","login"]}}},
    "first_action": {"summary":"Activation: the first moment of real value. ONE event for every product — which moment it was is the `action` property, never a new event name.","props":{"action":{"type":"string","doc":"The product-specific moment that counted as activation.","values":["api_call","app_live","chat_reply"]}}},
    "waitlist_joined": {"summary":"Someone joined a waitlist.","props":{}},
    "waitlist_shared": {"summary":"Someone shared their waitlist position.","props":{}},
    "referral_used": {"summary":"A referral code was applied.","props":{}},
    "referral_claimed": {"summary":"A referral reward was claimed.","props":{}},
    "pricing_viewed": {"summary":"The pricing surface was shown.","props":{}},
    "plan_clicked": {"summary":"A specific plan was chosen from pricing.","props":{"plan":{"type":"string","doc":"The plan name as the catalog spells it."},"interval":{"type":"string","doc":"Billing interval.","values":["monthly","annual"]},"from":{"type":"string","doc":"Where the plan was pressed."}}},
    "checkout_viewed": {"summary":"The card step was shown with its plan and price to a visitor not signed in yet.","props":{"plan":{"type":"string","doc":"The plan the card step names, by its catalog slug."},"interval":{"type":"string","doc":"The term the card step prices: month or year."},"method":{"type":"string","doc":"The way of paying the step is for, such as card."}}},
    "checkout_started": {"summary":"The billing form was shown with a total.","props":{"plan":{"type":"string","doc":"The plan id.","values":["free","dev","max","team_standard","team_premium"]},"interval":{"type":"string","doc":"Billing interval.","values":["monthly","annual"]},"seats":{"type":"number","doc":"Seats; 1 for an individual plan."}}},
    "order_completed": {"summary":"Payment succeeded and the order exists. Stated by the server on payment confirmation.","props":{"order_id":{"type":"string","doc":"The processor reference; the browser and server copies share it."},"value":{"type":"number","doc":"What the card was charged, in major units."},"currency":{"type":"string","doc":"ISO 4217 code."},"plan":{"type":"string","doc":"The plan bought."},"seats":{"type":"number","doc":"Seats bought; 1 for an individual plan."}}},
    "plan_selected": {"summary":"Checkout opened on a plan.","props":{"plan":{"type":"string","doc":"The plan id.","values":["free","dev","max","team_standard","team_premium"]},"interval":{"type":"string","doc":"Billing interval.","values":["monthly","annual"]},"seats":{"type":"number","doc":"Seats; 1 for an individual plan."}}},
    "plan_skipped": {"summary":"The visitor chose to stay on the free plan.","props":{}},
    "plan_changed": {"summary":"In checkout the plan was swapped, monthly and annual were switched, or seats were adjusted.","props":{"from":{"type":"string","doc":"The plan or interval before the change."},"to":{"type":"string","doc":"The plan or interval after the change."},"field":{"type":"string","doc":"What changed.","values":["plan","interval","seats"]}}},
    "upgrade_clicked": {"summary":"An upgrade entry inside a product was pressed.","props":{"from":{"type":"string","doc":"The entry: pill, menu, settings, limit."}}},
    "payment_info_added": {"summary":"The card was tokenized by the payment form. No card data leaves the form.","props":{"plan":{"type":"string","doc":"The plan id.","values":["free","dev","max","team_standard","team_premium"]},"interval":{"type":"string","doc":"Billing interval.","values":["monthly","annual"]},"seats":{"type":"number","doc":"Seats; 1 for an individual plan."}}},
    "checkout_abandoned": {"summary":"A visitor opened checkout with a plan or amount and left the page without completing payment.","props":{"plan":{"type":"string","doc":"The plan id.","values":["free","dev","max","team_standard","team_premium"]},"interval":{"type":"string","doc":"Billing interval.","values":["monthly","annual"]},"seats":{"type":"number","doc":"Seats; 1 for an individual plan."},"value":{"type":"number","doc":"Total value of the abandoned checkout in major units."},"currency":{"type":"string","doc":"ISO 4217 currency code."},"step":{"type":"string","doc":"The last checkout step reached before leaving.","values":["viewed","started","payment_info"]}}},
    "checkout_failed": {"summary":"Checkout ended in a decline or an error.","props":{"reason":{"type":"string","doc":"A short reason code, never card data."}}},
    "subscription_changed": {"summary":"A subscription was upgraded, downgraded or its seats changed after purchase.","props":{"from":{"type":"string","doc":"The plan before."},"to":{"type":"string","doc":"The plan after."}}},
    "subscription_canceled": {"summary":"A subscription was canceled.","props":{"plan":{"type":"string","doc":"The plan canceled."}}},
    "order_refunded": {"summary":"An order was refunded.","props":{"order_id":{"type":"string","doc":"The order the refund belongs to."}}},
    "sales_contacted": {"summary":"The enterprise or buying-specialist form was sent.","props":{}},
    "product_viewed": {"summary":"A product, model or service page was shown.","props":{"content_type":{"type":"string","doc":"What the page is about.","values":["product","model","category","service"]},"item_id":{"type":"string","doc":"The product slug or model id the page is for."},"item_name":{"type":"string","doc":"The name the page gives it."}}},
    "search_performed": {"summary":"A visitor searched the site or a catalog.","props":{"search_string":{"type":"string","doc":"What was typed, as typed."},"from":{"type":"string","doc":"Which search: the palette, the model catalog."}}},
    "cta_clicked": {"summary":"A call to action on a page was pressed.","props":{"cta":{"type":"string","doc":"Which call to action, e.g. try_hanzo."},"page":{"type":"string","doc":"The page or section it was on."}}},
    "newsletter_subscribed": {"summary":"An address was signed up for the newsletter.","props":{"source":{"type":"string","doc":"Where the sign-up form was."}}},
    "beta_submitted": {"summary":"A beta application was filed.","props":{"program":{"type":"string","doc":"The beta programme applied for."}}},
    "research_access_applied": {"summary":"Research access to an unreleased model was requested.","props":{}},
    "usage_selected": {"summary":"The person said how they will use the product.","props":{"use":{"type":"string","doc":"How it will be used.","values":["personal","team","enterprise"]}}},
    "team_created": {"summary":"A team organization was created.","props":{}},
    "first_chat_notice_accepted": {"summary":"The notice before the first chat was accepted.","props":{"train_opt_in":{"type":"boolean","doc":"Whether chats may train Zen models."}}},
    "name_set": {"summary":"The person told us what to call them.","props":{}},
    "role_selected": {"summary":"The person picked the kind of work they do.","props":{"role":{"type":"string","doc":"The role as the list spells it."}}},
    "starter_prompt_used": {"summary":"A starter prompt card opened a chat.","props":{"role":{"type":"string","doc":"The role the card belongs to."},"prompt":{"type":"string","doc":"The card label."}}},
    "own_topic_chosen": {"summary":"The person chose to start with their own topic.","props":{}},
    "feature_used": {"summary":"The generic usage event, for a surface with no dedicated name yet.","props":{}},
    "api_key_created": {"summary":"An API key was minted.","props":{}},
    "app_created": {"summary":"An app now exists.","props":{"source":{"type":"string","doc":"Where the app came from — a template, an import, or empty."}}},
    "project_created": {"summary":"A project now exists.","props":{}},
    "agent_created": {"summary":"An agent was defined.","props":{}},
    "chat_started": {"summary":"A conversation began.","props":{}},
    "chat_message_sent": {"summary":"A turn was sent in a conversation.","props":{"hasImages":{"type":"boolean","doc":"Whether the turn carried image attachments."}}},
    "model_switched": {"summary":"The user changed model or endpoint — the strongest quality signal a chat surface emits, because a switch usually follows a bad answer.","props":{}},
    "task_started": {"summary":"A task began.","props":{}},
    "task_completed": {"summary":"A task finished.","props":{}},
    "build_started": {"summary":"A build was requested.","props":{"mode":{"type":"string","doc":"How the build was invoked."},"withBase":{"type":"boolean","doc":"Whether the build provisions a Base alongside the app."}}},
    "generation_completed": {"summary":"A model finished producing an artifact — an app build, a chat reply, an agent run. It carries its own duration, so no paired start event is needed.","props":{"durationMs":{"type":"number","doc":"Wall-clock milliseconds the generation took."}}},
    "generation_failed": {"summary":"A model failed to produce its artifact.","props":{}},
    "deploy_started": {"summary":"A deploy was requested.","props":{"framework":{"type":"string","doc":"The framework detected or declared for the deploy."},"update":{"type":"boolean","doc":"Whether this replaces an existing deployment."},"source":{"type":"string","doc":"What triggered the deploy."}}},
    "deploy_succeeded": {"summary":"The artifact is live.","props":{}},
    "deploy_failed": {"summary":"The deploy did not reach live.","props":{}}
  },
  "platforms": {
