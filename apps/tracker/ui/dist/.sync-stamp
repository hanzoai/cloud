# Provenance of this embedded Todo SPA build. See ../README.md to regenerate.
#
# NOT embedded in the binary: `//go:embed dist` (no `all:`) omits dot-files, so
# this names the source without publishing it at /tracker/.sync-stamp.
app=@hanzo/tracker (apps/tracker)
base=/tracker/
api_prefix=/v1/tracker
auth=AuthGate (@hanzogui/admin) + @hanzo/iam PKCE
idp=brand registry: hostname -> hanzo.id | lux.id | zoolabs.id (VITE_IAM_BRAND pins)
callback=/tracker/callback
chrome=OrgSwitcher + view tabs (Todo/Boards/Milestones) left, UserMenu right; no nav rail
org_scope=X-Org-Id, resolved against the token's signed `orgs` claim; cloud re-mints it
views=todo (global board) | boards | board | timeline | milestones
source=hanzoai/admin:apps/tracker@3ddbed3 (main)
built=typecheck clean + vitest 12 + render probe 5/5 views RENDERS_DATA
