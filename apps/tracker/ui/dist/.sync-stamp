# Provenance of this embedded Tracker SPA build. See ../README.md to regenerate.
#
# NOT embedded in the binary: `//go:embed dist` (no `all:`) omits dot-files, so
# this names the source without publishing it at /tracker/.sync-stamp.
app=@hanzo/tracker (apps/tracker)
base=/tracker/
api_prefix=/v1/tracker
auth=AuthGate (@hanzogui/admin) + @hanzo/iam@0.9.4 PKCE
idp=https://hanzo.id/v1/iam   # the ONE identity provider, not the serving host
callback=/tracker/callback
chrome=OrgSwitcher (left) + UserMenu (right); no nav rail, no env/version/clock/theme
org_scope=X-Org-Id, selected from the token's signed `orgs` claim; cloud re-mints it
source=hanzoai/admin:apps/tracker@e3d5672 (main)
built=turbo typecheck 11/11 + vitest 311 pkg / 7 app + playwright 4/4 + vite build
