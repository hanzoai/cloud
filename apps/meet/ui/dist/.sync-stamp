# Provenance of this embedded Meet SPA build. See ../README.md to regenerate.
app=@hanzo/meet (apps/meet)
base=/meet/  — NOT the default any more: upstream now builds for the root its
     standalone image owns, so this embed is produced with VITE_BASE=/meet/ .
     A build without it emits /assets/ and this binary serves a blank 200.
api_prefix=/v1/meet
auth=AuthGate (@hanzogui/admin) + @hanzo/iam@0.9.4 PKCE
idp=brand registry: hostname -> hanzo.id | lux.id | zoolabs.id (VITE_IAM_BRAND pins)
callback=/meet/callback  — registered at IAM, not a function of the mount
signin=/meet/login  — derived from BASE_URL, so it tracks the mount instead of
     restating it. The literal it replaced was '/login', which under this mount
     is cloud's own console sign-in: a different app, a different IAM client,
     and a PKCE verifier this one could never find.
mint=POST /v1/meet/getToken CARRIES the bearer (sessionHeaders) — meet.hanzo.ai
     is bearer-only (host-only cookies), so without it every room join 401s
source=hanzoai/admin:apps/meet@7bbe2fa (main)
built=tsc --noEmit clean + vitest 20/20 (apps/meet), 41/41 (pkgs/admin auth)
