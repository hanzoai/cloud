{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Package agentskills is the skill catalogue an AI client reads to learn what it can do.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "paths": {
    "/.well-known/agent-skills/index.json": {
      "get": {
        "operationId": "get_.well-known_agent-skills_index.json"
      }
    },
    "/.well-known/agent-skills/{skill}/SKILL.md": {
      "get": {
        "operationId": "get_.well-known_agent-skills_by_skill_skill.md",
        "parameters": [
          {
            "name": "skill",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
