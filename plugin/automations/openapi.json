        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/automations/flows/{id}/enable": {
      "post": {
        "operationId": "post_v1_automations_flows_id_enable",
        "summary": "enableFlow enables one of the caller org's flows and arms its trigger: a polling",
        "description": "enableFlow enables one of the caller org's flows and arms its trigger: a polling\ntrigger gets a durable schedule, a webhook trigger a subscription in the routing\nindex.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path, as returned by create.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
