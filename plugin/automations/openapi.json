    "/v1/automations/flows/{id}/run": {
      "post": {
        "operationId": "post_v1_automations_flows_id_run",
        "summary": "runFlow starts a durable run of one of the caller org's flows, using its\npublished version when set and its latest otherwise.",
        "description": "runFlow starts a durable run of one of the caller org's flows, using its\npublished version when set and its latest otherwise. It answers 503 while the\nengine is not ready and 429 when the org is over its concurrency or per-minute\nrun budget — never a run that was silently dropped.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path, as returned by create.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "id": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
              },
              "schema": {
                "$ref": "#/components/schemas/FlowRef"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowRun"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
