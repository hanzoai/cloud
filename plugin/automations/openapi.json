  "paths": {
    "/v1/automations/connectors": {
      "get": {
        "operationId": "get_v1_automations_connectors",
        "summary": "connectors returns the connector catalogue — every connector this deployment",
        "description": "connectors returns the connector catalogue — every connector this deployment\nships, with the actions and triggers each offers.",
        "tags": [
          "automations"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/automations/connectors/{id}/run": {
      "post": {
        "operationId": "post_v1_automations_connectors_by_id_run",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/automations/flows": {
      "get": {
        "operationId": "get_v1_automations_flows",
        "summary": "listFlows returns the caller org's flows, most recently updated first.",
        "description": "listFlows returns the caller org's flows, most recently updated first.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned; 0 means 50 and nothing above 200 is honoured.",
            "schema": {
              "type": "integer"
            },
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_automations_flows",
        "summary": "createFlow creates a flow and its initial draft version in one write, and\nreturns the flow with that version.",
        "description": "createFlow creates a flow and its initial draft version in one write, and\nreturns the flow with that version. The flow starts disabled.",
        "tags": [
          "automations"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "displayName": "Nightly sync",
                "trigger": {
                  "name": "cron",
                  "type": "POLLING"
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreateFlowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PopulatedFlow"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/automations/flows/{id}": {
      "delete": {
        "operationId": "delete_v1_automations_flows_id",
        "summary": "deleteFlow deletes one of the caller org's flows with its versions and runs, and\nanswers 204.",
        "description": "deleteFlow deletes one of the caller org's flows with its versions and runs, and\nanswers 204. A flow belonging to another org reads as not found.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path, as returned by create.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      },
      "get": {
        "operationId": "get_v1_automations_flows_id",
        "summary": "getFlow returns one of the caller org's flows together with its latest version —",
        "description": "getFlow returns one of the caller org's flows together with its latest version —\nthe shape the builder loads.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path, as returned by create.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PopulatedFlow"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "patch": {
        "operationId": "patch_v1_automations_flows_id",
        "summary": "updateFlow updates one of the caller org's flows: its folder, external id,\npublished version or metadata.",
        "description": "updateFlow updates one of the caller org's flows: its folder, external id,\npublished version or metadata. An absent field is left unchanged, and a\npublished version must name a version of this same flow.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path; a body value is ignored.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "id": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a",
                "publishedVersionId": "ver_9b1d3f5027a4c1e9b7a2d6f0538e4a7c"
              },
              "schema": {
                "$ref": "#/components/schemas/PatchFlowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flow"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/automations/flows/{id}/disable": {
      "post": {
        "operationId": "post_v1_automations_flows_id_disable",
        "summary": "disableFlow disables one of the caller org's flows and disarms its trigger, so a",
        "description": "disableFlow disables one of the caller org's flows and disarms its trigger, so a\ndisabled flow is never a live target.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path, as returned by create.",
