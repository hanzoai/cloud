    "/v1/automations/runs": {
      "get": {
        "operationId": "get_v1_automations_runs",
        "summary": "listRuns returns the caller org's runs, most recent first, optionally narrowed",
        "description": "listRuns returns the caller org's runs, most recent first, optionally narrowed\nto one flow.",
