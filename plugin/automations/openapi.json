    "/v1/automations/pieces": {
      "get": {
        "operationId": "get_v1_automations_pieces",
        "summary": "pieces is the back-compat alias of connectors: the same catalogue at the",
        "description": "pieces is the back-compat alias of connectors: the same catalogue at the\npre-rename path, so clients pinned to it keep working.",
