      "post": {
        "operationId": "post_v1_automations_flows_id_versions",
        "summary": "createVersion adds a draft version to one of the caller org's flows and returns\nit.",
        "description": "createVersion adds a draft version to one of the caller org's flows and returns\nit. The version starts as a draft with no steps.",
        "tags": [
          "automations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the flow id from the path; a body value is ignored.",
            "schema": {
              "type": "string"
            },
            "example": "flow_4c1e9b7a2d6f0538e4a7c9b1d3f5027a"
          }
