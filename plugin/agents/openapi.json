{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Generated from the live router — every operation below is a route the unified cloud binary actually serves. Tagged by product: the first path segment after /v1/.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "agents"
    }
  ],
  "paths": {
    "/v1/agents": {
      "get": {
        "operationId": "get_v1_agents",
        "summary": "listAgents returns every agent in the caller's org with its run count.",
        "description": "listAgents returns every agent in the caller's org with its run count.\nThe count is of runs actually recorded, so it matches what the run history\nwill show.",
        "tags": [
          "agents"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agentList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_agents",
        "summary": "createAgent registers a new agent in the caller's org and answers 201.",
        "description": "createAgent registers a new agent in the caller's org and answers 201.\nThe name must be unique in the org, and the model is checked against the\nmodels this gateway actually serves, so an unservable model is refused here\nrather than failing at the first run.\nA long-running agent needs a cron schedule, and the org's long-running\nagents are capped.",
        "tags": [
          "agents"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "executionMode": "on-demand",
                "instructions": "Triage inbound support mail.",
                "model": "zen",
                "name": "triage"
              },
              "schema": {
                "$ref": "#/components/schemas/createReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agentView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/agents/activity": {
      "get": {
        "operationId": "get_v1_agents_activity",
        "summary": "agentActivity serves the org-wide recent-activity feed, newest first.",
        "description": "agentActivity serves the org-wide recent-activity feed, newest first.\nEvery event is real — a recorded run becomes an invoked or failed event, and\nan agent's own timestamps become created and updated events.\nAn org with no agents and no runs gets an empty feed.",
        "tags": [
          "agents"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activityFeed"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/builds": {
      "get": {
        "operationId": "get_v1_agents_builds",
        "tags": [
          "agents"
        ]
      }
    },
    "/v1/agents/builds/{org}/{project}": {
      "get": {
        "operationId": "get_v1_agents_builds_by_org_by_project",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/metrics": {
      "get": {
        "operationId": "get_v1_agents_metrics",
        "summary": "agentMetrics serves the org's invocations-over-time histogram.",
        "description": "agentMetrics serves the org's invocations-over-time histogram.\nThere is one series line per agent that ran in the window, and every point is\na real count of recorded runs in that bucket — an org with no activity gets\nan empty series, never a synthesized trend.\nThe resource rollup is all-null because this store meters no CPU, memory,\nstorage or cost, so the console renders a dash rather than a fabricated\nfigure.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Range is the window to bucket over: 24H, 7D or 30D (the default).",
            "schema": {
              "type": "string"
            },
            "example": "7D"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/metricsView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/sessions": {
      "get": {
        "operationId": "get_v1_agents_sessions",
        "summary": "listSessions returns the caller org's agent sessions, newest first.",
        "description": "listSessions returns the caller org's agent sessions, newest first.\nIt narrows by flow (root), by direct parent, by status, by the product a\nsession built, or by any combination of those.\nEach row carries its event and child counts and its most recent event, so a\nboard can render a flow without a second read per session.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "root",
            "in": "query",
            "required": false,
            "description": "Root narrows to one flow: every session sharing this root id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "description": "Parent narrows to the direct children of one session.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Status narrows to running, paused, done or error.",
            "schema": {
              "type": "string"
            },
            "example": "running"
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Project narrows to the sessions that built one product.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned.",
            "schema": {
              "type": "integer"
            },
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessionList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_agents_sessions",
        "summary": "registerSession opens a session — one agent run, recorded as it happens.",
        "description": "registerSession opens a session — one agent run, recorded as it happens.\nA session with a parentSessionId joins that parent's flow and inherits its\nroot, so a subagent tree is one addressable unit; the parent must be in the\ncaller's OWN org, so a tree can never cross a tenant boundary.\nStatus defaults to running, actor defaults to the validated caller, and a\nsession that names a target must name one registered to the same org.",
        "tags": [
          "agents"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "agent": "triage",
                "repo": "hanzoai/cloud",
                "title": "Fix the flaky import test"
              },
              "schema": {
                "$ref": "#/components/schemas/registerReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessionView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/agents/sessions/stream": {
      "get": {
        "operationId": "get_v1_agents_sessions_stream",
        "tags": [
          "agents"
        ]
      }
    },
    "/v1/agents/sessions/{id}": {
      "get": {
        "operationId": "get_v1_agents_sessions_id",
        "summary": "getSession returns one session with its direct children and recent events.",
        "description": "getSession returns one session with its direct children and recent events.\nA session in another org reads as not-found, so a probe learns nothing about\nwhat exists elsewhere.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the session to act on, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "sess_1"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessionDetail"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "patch": {
        "operationId": "patch_v1_agents_sessions_id",
        "summary": "patchSession updates one session in place, leaving every omitted field alone.",
        "description": "patchSession updates one session in place, leaving every omitted field alone.\nA finished session stays finished: reopening a done or error run would\nfabricate liveness, so a status change away from a terminal state is refused.\nPublishing requires the session to name the product it built, because the\npublic build route is keyed on (org, project), and a target must be one\nregistered to the caller's own org.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the session to update, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "sess_1"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "id": "sess_1",
                "published": true,
                "status": "done"
              },
              "schema": {
                "$ref": "#/components/schemas/patchSessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessionView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/sessions/{id}/control": {
      "get": {
        "operationId": "get_v1_agents_sessions_by_id_control",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/events": {
      "post": {
        "operationId": "post_v1_agents_sessions_by_id_events",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/message": {
      "post": {
        "operationId": "post_v1_agents_sessions_by_id_message",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/pause": {
      "post": {
        "operationId": "post_v1_agents_sessions_by_id_pause",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/resume": {
      "post": {
        "operationId": "post_v1_agents_sessions_by_id_resume",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/stop": {
      "post": {
        "operationId": "post_v1_agents_sessions_by_id_stop",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/sessions/{id}/tree": {
      "get": {
        "operationId": "get_v1_agents_sessions_id_tree",
        "summary": "sessionTree returns the subagent tree rooted at one session.",
        "description": "sessionTree returns the subagent tree rooted at one session.\nEvery node carries its own event count and fan-out, so a flow renders from one\nread; the whole tree is pulled by a single indexed query on the shared root id\nand assembled in memory.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the session to act on, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "sess_1"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/treeNode"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/targets": {
      "get": {
        "operationId": "get_v1_agents_targets",
        "summary": "listTargets returns every machine registered to the caller's org.",
        "description": "listTargets returns every machine registered to the caller's org.\nRows come newest first, each carrying the machine's spec, its last\nutilisation sample and the live session load dispatched to it.",
        "tags": [
          "agents"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/targetList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_agents_targets",
        "summary": "registerTarget registers a machine as an agent target, or re-links one.",
        "description": "registerTarget registers a machine as an agent target, or re-links one.\nRe-linking is idempotent and keyed on org+host+owner, so a machine that\nreconnects refreshes its own row rather than piling up duplicates; it answers\n200, while a first registration answers 201.\nThe registering principal owns the machine — only it, or an org admin, may\nlater patch, claim or remove it.",
        "tags": [
          "agents"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "host": "gpu-01",
                "kind": "gpu",
                "label": "workshop"
              },
              "schema": {
                "$ref": "#/components/schemas/targetReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/targetView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/targets/{id}": {
      "delete": {
        "operationId": "delete_v1_agents_targets_id",
        "summary": "deleteTarget deregisters one machine.",
        "description": "deleteTarget deregisters one machine.\nOnly its owner, or an org admin, may remove it; an unknown id, a cross-org id\nand a machine owned by someone else all answer the same not-found, so a probe\nlearns nothing about what exists.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the target to act on, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "tgt_1"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/targetDeleted"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "get": {
        "operationId": "get_v1_agents_targets_id",
        "summary": "getTarget returns one registered machine with its live session load.",
        "description": "getTarget returns one registered machine with its live session load.\nAn id from another org reads as not-found, so a probe learns nothing about\nwhat exists elsewhere.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the target to act on, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "tgt_1"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/targetView"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "patch": {
        "operationId": "patch_v1_agents_targets_id",
        "summary": "patchTarget updates one machine in place, leaving every omitted field alone.",
        "description": "patchTarget updates one machine in place, leaving every omitted field alone.\nA metrics patch IS a heartbeat — the server stamps its own clock, so a client\ncan neither forge nor backdate staleness.\nOnly the machine's owner, or an org admin, may patch it; anyone else gets the\nsame not-found an unknown id gives.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the target to update, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "tgt_1"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "id": "tgt_1",
                "status": "draining"
              },
              "schema": {
                "$ref": "#/components/schemas/patchTargetIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/targetView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/targets/{id}/claim": {
      "post": {
        "operationId": "post_v1_agents_targets_by_id_claim",
        "tags": [
