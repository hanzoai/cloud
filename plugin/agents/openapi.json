    "/v1/agents/{ref}": {
      "delete": {
        "operationId": "delete_v1_agents_ref",
        "summary": "deleteAgent removes one agent and its recorded run history, answering 204.",
        "description": "deleteAgent removes one agent and its recorded run history, answering 204.\nThe ref resolves by public id or org-unique name.\nAn agent in another org, or one already gone, reads as not-found.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Ref is the agent's public id or its org-unique name, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "triage"
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      },
      "get": {
        "operationId": "get_v1_agents_ref",
        "summary": "getAgent returns one agent's configuration and its 20 most recent runs.",
        "description": "getAgent returns one agent's configuration and its 20 most recent runs.\nThe ref is the agent's public id or its org-unique name — either resolves.\nAn agent in another org reads as not-found.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Ref is the agent's public id or its org-unique name, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "triage"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agentDetail"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "patch": {
        "operationId": "patch_v1_agents_ref",
        "summary": "updateAgent changes one agent in place, leaving every omitted field alone.",
        "description": "updateAgent changes one agent in place, leaving every omitted field alone.\nThe resulting mode and schedule are re-validated together, so a partial\nupdate can never leave a long-running agent without a cron the scheduler can\nread, and a move INTO long-running is held to the same per-org cap as a\ncreate.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Ref is the agent to update: its public id or its org-unique name, from\nthe path.",
            "schema": {
              "type": "string"
            },
            "example": "triage"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "executionMode": "long-running",
                "ref": "triage",
                "schedule": "0 * * * *"
              },
              "schema": {
                "$ref": "#/components/schemas/updateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agentView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/agents/{ref}/run": {
      "post": {
        "operationId": "post_v1_agents_by_ref_run",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/agents/{ref}/runs": {
      "get": {
        "operationId": "get_v1_agents_ref_runs",
        "summary": "listAgentRuns returns one agent's recorded run history, newest first.",
        "description": "listAgentRuns returns one agent's recorded run history, newest first.\nEvery row is an execution that really happened — a run whose model failed is\nrecorded with status error and its upstream message, never dropped.",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Ref is the agent whose runs to read: its public id or its org-unique\nname, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "triage"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the runs returned; 0 means 50.",
            "schema": {
              "type": "integer"
            },
            "example": 20
          }
        ],
