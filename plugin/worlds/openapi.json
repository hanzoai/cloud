  "components": {
    "schemas": {
      "problem-details": {
        "description": "An RFC 9457 problem document.",
        "properties": {
          "code": {
            "description": "A stable token a client can branch on, when the refusal names one.",
            "type": "string"
          },
          "detail": {
            "description": "What was refused, for a person to read.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "The status's reason phrase.",
            "type": "string"
          },
          "type": {
            "description": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "worlds.Candidate": {
        "properties": {
          "actions": {
            "items": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "cost": {
            "format": "double",
            "type": "number"
          },
          "id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "worlds.Create": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "worlds.Event": {
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "features": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "modality": {
            "type": "string"
          },
          "neighbors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "timestamp": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "worlds.Inference": {
        "properties": {
          "belief": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "observation": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "policies": {
            "items": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "worlds.Model": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "release_stage": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "worlds.Models": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/worlds.Model"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "worlds.Plan": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/worlds.Candidate"
            },
            "type": "array"
          },
          "entity_id": {
            "type": "string"
          },
          "target": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "worlds.Rollout": {
        "properties": {
          "actions": {
            "items": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "entity_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The caller's credential, sent as `Authorization: Bearer \u003ctoken\u003e`. It is either an access token minted by Hanzo IAM or an API key (pk-/sk-). X-Authorization, and HTTP Basic carrying the token as the password, are accepted spellings of the same header for clients that cannot set Authorization; a browser presents the session cookie instead. Every operation requires it unless it says `security: []`."
      }
    }
  }
}
