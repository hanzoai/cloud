          "required": true
        },
        "responses": {
          "204": {
            "description": "no content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      }
    },
