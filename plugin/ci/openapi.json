{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Package ci mounts the CI dashboard as a capability of this binary.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "ci"
    }
  ],
  "paths": {
    "/v1/ci/runs": {
      "get": {
        "operationId": "get_ci_runs",
        "summary": "Lists recent builds: the repo, the branch, the commit and how each run ended, newest first.",
        "description": "Lists recent builds: the repo, the branch, the commit and how each run\nended, newest first. A run names a repo, a branch and an actor, so the list is\nnever wider than the caller — a SuperAdmin sees the fleet, an org member sees\nonly its own org.",
        "tags": [
          "ci"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ci.Executions"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      }
    }
  },
  "components": {
    "schemas": {
      "ci.Execution": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          },
          "endedAt": {
            "format": "date-time",
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "number": {
            "format": "int64",
            "type": "integer"
          },
          "org": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "Status and Conclusion are BOTH required to know how a run went, and\nreading only one is wrong in a way that looks fine. Status answers\n\"is it over\" (queued | in_progress | completed); Conclusion answers\n\"how did it end\" and is empty until it is over. A view that buckets on\nStatus alone sees `completed` and cannot tell a pass from a failure, so\nit draws every finished run — successes and cancellations included — the\nsame way.",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ci.Executions": {
        "properties": {
          "fetchedAt": {
            "format": "date-time",
            "type": "string"
          },
          "orgs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repos": {
            "format": "int64",
            "type": "integer"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/ci.Execution"
            },
            "type": "array"
          },
          "sourceErr": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "problem-details": {
        "description": "An RFC 9457 problem document.",
        "properties": {
          "code": {
            "description": "A stable token a client can branch on, when the refusal names one.",
            "type": "string"
          },
          "detail": {
            "description": "What was refused, for a person to read.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "The status's reason phrase.",
            "type": "string"
          },
          "type": {
            "description": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "detail"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The caller's credential, sent as `Authorization: Bearer \u003ctoken\u003e`. It is either an access token minted by Hanzo IAM or an API key (pk-/sk-). X-Authorization, and HTTP Basic carrying the token as the password, are accepted spellings of the same header for clients that cannot set Authorization; a browser presents the session cookie instead. Every operation requires it unless it says `security: []`."
      }
    }
  }
}
