{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Package library is the Library: everything a person made, in one place.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "library"
    }
  ],
  "paths": {
    "/v1/library": {
      "get": {
        "operationId": "get_library",
        "summary": "Lists what you made and what members of your organization shared with you, newest first.",
        "description": "Lists what you made and what members of your organization shared\nwith you, newest first. Narrow it by kind, source, ref, project, a name search\nand a time range; `scope` mine keeps only yours and shared only what others\nshared. Each item carries signed URLs that work for an hour.",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Kind keeps one kind: image, video, audio, document, slides, type, model, code or file.",
            "schema": {
              "type": "string"
            },
            "example": "image"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Source keeps what one product made: chat, dev, studio or workflow.",
            "schema": {
              "type": "string"
            },
            "example": "studio"
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "description": "Ref keeps what one conversation, run or Studio run made.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Project keeps one project's items.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Q keeps the items whose name contains it, ignoring case.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Since and Until bound when it was made: RFC 3339, or a date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Scope is all (yours and what your org shared, the default), mine, or shared.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit bounds the page: default 60, at most 200.",
            "schema": {
              "format": "int64",
              "type": "integer"
            },
            "example": 24
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor continues a list from the page before's `next`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/library.itemPage"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      },
      "post": {
        "operationId": "post_library",
        "summary": "Keeps one thing you made in your Library: its bytes go to your own prefix of the Library's store, and it is listed to you alone until you share it.",
        "description": "Keeps one thing you made in your Library: its bytes go to your own\nprefix of the Library's store, and it is listed to you alone until you share\nit. Send `data` up to 10 MiB inline, or send `bytes` up to 2 GiB to reserve\na signed `upload` PUT and finish it with `PATCH /v1/library/:id` `{\"commit\": true}`.\nA save with the `key` of one already kept answers that item.",
        "tags": [
          "library"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "data": "iVBORw0…",
                "mime": "image/png",
                "name": "poster.png",
                "origin": "/chat?thread=conv_1",
                "ref": "conv_1",
                "source": "chat"
              },
              "schema": {
                "$ref": "#/components/schemas/library.keepIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/library.LibraryItem"
                }
              }
            },
            "description": "created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      }
    },
    "/v1/library/unowned": {
      "get": {
        "operationId": "get_library_unowned",
        "summary": "ListUnowned reads, for a SuperAdmin alone, the organization's items that record no owner.",
        "description": "ListUnowned reads, for a SuperAdmin alone, the organization's items that record\nno owner. Such an item is nobody's: no member lists it, reads it\nor changes it, and this view neither changes it nor signs its bytes. Every\nread of it is written to the audit trail.",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit bounds the page: default 60, at most 200.",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/library.itemPage"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      }
    },
    "/v1/library/{id}": {
      "delete": {
        "operationId": "delete_library_by_id",
        "summary": "Deletes one of your items and its bytes.",
        "description": "Deletes one of your items and its bytes. Only its owner deletes an\nitem.",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the item, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "lib_0f3c…"
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      },
      "get": {
        "operationId": "get_library_by_id",
        "summary": "Reads one item with fresh signed URLs.",
        "description": "Reads one item with fresh signed URLs. An item that is not yours and\nwas not shared with your organization answers 404, as one that does not exist.",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the item, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "lib_0f3c…"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/library.LibraryItem"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      },
      "patch": {
        "operationId": "patch_library_by_id",
        "summary": "Renames one of your items, shares it with your organization or stops sharing it, moves it to a project, or commits a reserved upload.",
        "description": "Renames one of your items, shares it with your organization or\nstops sharing it, moves it to a project, or commits a reserved upload. Only\nits owner changes an item; a member's shared item answers 404 here as one\nthat does not exist.",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the item, from the path.",
            "schema": {
              "type": "string"
            },
            "example": "lib_0f3c…"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "id": "lib_0f3c…",
                "shared": true
              },
              "schema": {
                "$ref": "#/components/schemas/library.itemPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/library.LibraryItem"
                }
              }
            },
            "description": "ok"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem-details"
                }
              }
            },
            "description": "refused"
          }
        },
        "x-public": true,
        "x-tool": true
      }
    }
  },
  "components": {
    "schemas": {
      "library.Field": {
        "properties": {
          "name": {
            "description": "Name is the field's name.",
            "type": "string"
          },
          "value": {
            "description": "Value is the field's value, verbatim.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "library.LibraryItem": {
        "properties": {
          "by": {
            "description": "By is the owner as a reader names them: the name, else the address, the\nidentity boundary carried when the item was made.",
            "type": "string"
          },
          "bytes": {
            "format": "int64",
            "type": "integer"
          },
          "created": {
            "type": "string"
          },
          "download": {
            "type": "string"
          },
          "expires": {
            "type": "string"
          },
          "height": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "mine": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "pages": {
            "format": "int64",
            "type": "integer"
          },
          "preview": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "seconds": {
            "format": "double",
            "type": "number"
          },
          "shared": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          },
          "upload": {
            "$ref": "#/components/schemas/library.LibraryUpload",
            "description": "Upload is where a reserved item's bytes go, on the reservation response\nbefore it is committed."
          },
          "url": {
            "type": "string"
          },
          "width": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "library.LibraryUpload": {
        "properties": {
          "expires": {
            "type": "string"
          },
          "headers": {
            "description": "Headers are the ones the PUT must carry.",
            "items": {
              "$ref": "#/components/schemas/library.Field"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "library.itemPage": {
        "properties": {
          "data": {
            "description": "Data are the items, newest first.",
            "items": {
              "$ref": "#/components/schemas/library.LibraryItem"
            },
            "type": "array"
          },
          "next": {
            "description": "Next continues the list as `cursor`; empty at its end.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "library.itemPatch": {
        "properties": {
          "commit": {
            "description": "Commit finishes a reserved upload once its bytes have been PUT.",
            "type": "boolean"
          },
          "id": {
            "description": "ID is the item, from the path.",
            "type": "string"
          },
          "name": {
            "description": "Name renames it.",
            "type": "string"
          },
          "project": {
            "description": "Project moves it to one of the organization's projects; \"\" moves it out.",
            "type": "string"
          },
          "shared": {
            "description": "Shared shows it to every member of your organization, or stops.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "library.keepIn": {
        "properties": {
          "bytes": {
            "description": "Bytes reserves an upload of this size, at most 2 GiB, when data is empty, and returns a signed PUT in upload.",
            "format": "int64",
            "type": "integer"
          },
          "data": {
            "contentEncoding": "base64",
            "description": "Data is the bytes, base64, at most 10 MiB; omit when reserving with bytes.",
            "type": "string"
          },
          "height": {
            "format": "int64",
            "type": "integer"
          },
          "key": {
            "description": "Key makes the save idempotent: the same source and key answer the item\nalready kept.",
            "type": "string"
          },
          "kind": {
            "description": "Kind is image, video, audio, document, slides, type, model, code or file;\nabsent derives it from mime.",
            "type": "string"
          },
          "mime": {
            "description": "Mime is its media type. Required.",
            "type": "string"
          },
          "name": {
            "description": "Name is what it is called, a file name. Required.",
            "type": "string"
          },
          "origin": {
            "description": "Origin is the path on this site back to what made it, as /chat?thread=….",
            "type": "string"
          },
          "pages": {
            "format": "int64",
            "type": "integer"
          },
          "preview": {
            "contentEncoding": "base64",
            "description": "Preview is a still that shows it, base64, at most 2 MiB.",
            "type": "string"
          },
          "project": {
            "description": "Project is one of the organization's projects, by slug.",
            "type": "string"
          },
          "ref": {
            "description": "Ref is what made it: the conversation, the run.",
            "type": "string"
          },
          "seconds": {
            "format": "double",
            "type": "number"
          },
          "source": {
            "description": "Source is the product it came from: chat, dev, studio or workflow. Required.",
            "type": "string"
          },
          "width": {
            "description": "Width, Height, Seconds and Pages describe it when known.",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "problem-details": {
        "description": "An RFC 9457 problem document.",
        "properties": {
          "code": {
            "description": "A stable token a client can branch on, when the refusal names one.",
            "type": "string"
          },
          "detail": {
            "description": "What was refused, for a person to read.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "The status's reason phrase.",
            "type": "string"
          },
          "type": {
            "description": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "detail"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The caller's credential, sent as `Authorization: Bearer \u003ctoken\u003e`. It is either an access token minted by Hanzo IAM or an API key (pk-/sk-). X-Authorization, and HTTP Basic carrying the token as the password, are accepted spellings of the same header for clients that cannot set Authorization; a browser presents the session cookie instead. Every operation requires it unless it says `security: []`."
      }
    }
  }
}
