        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/plans/gpu": {
      "get": {
        "operationId": "get_v1_plans_gpu",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/health": {
      "get": {
        "operationId": "get_v1_plans_health",
        "summary": "health reports that the plans subsystem is mounted and answering.",
        "description": "health reports that the plans subsystem is mounted and answering. It runs no JS\nand reads no catalog, so it stays true when the bundle cannot resolve a plan.",
        "tags": [
          "plans"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "service": "plans",
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/healthView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/plans/policy": {
      "get": {
        "operationId": "get_v1_plans_policy",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/regions": {
      "get": {
        "operationId": "get_v1_plans_regions",
        "tags": [
