    "/v1/plans/vocab": {
      "get": {
        "operationId": "get_v1_plans_vocab",
        "tags": [
          "plans"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "healthView": {
        "properties": {
          "service": {
            "description": "Service names which subsystem answered, so a shadowing route is visible.",
            "type": "string"
          },
          "status": {
            "description": "Status is \"ok\" whenever the route answers — the probe is native, so it needs\nneither the bundle nor a catalog to reply.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
