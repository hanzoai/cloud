{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Generated from the live router — every operation below is a route the unified cloud binary actually serves. Tagged by product: the first path segment after /v1/.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "plans"
    }
  ],
  "paths": {
    "/v1/plans": {
      "get": {
        "operationId": "get_v1_plans",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/blockchain": {
      "get": {
        "operationId": "get_v1_plans_blockchain",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/cloud": {
      "get": {
        "operationId": "get_v1_plans_cloud",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/dns": {
      "get": {
        "operationId": "get_v1_plans_dns",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/plans/entitlements/{id}": {
      "get": {
        "operationId": "get_v1_plans_entitlements_by_id",
        "tags": [
          "plans"
