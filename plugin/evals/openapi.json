{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Generated from the live router — every operation below is a route the unified cloud binary actually serves. Tagged by product: the first path segment after /v1/.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "evals"
    }
  ],
  "paths": {
    "/v1/evals/dataset-items": {
      "get": {
        "operationId": "listDatasetItems",
        "summary": "listItems returns one dataset's rows, active and archived alike.",
        "description": "listItems returns one dataset's rows, active and archived alike. The dataset is\nresolved within the caller's org, so another org's dataset reads as empty.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "datasetName",
            "in": "query",
            "required": true,
            "description": "Dataset is the dataset name to read. Required.",
            "schema": {
              "type": "string"
            },
            "example": "support-golden"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned.",
            "schema": {
              "type": "integer"
            },
            "example": 100
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "createDatasetItem",
        "summary": "createItem adds one row to a dataset and answers 201.",
        "description": "createItem adds one row to a dataset and answers 201. The dataset must already exist\nin the caller's org — an item can never be attached to a dataset the caller does not\nown. An id already used by a different dataset is a conflict.",
        "tags": [
          "evals"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "datasetName": "support-golden",
                "expectedOutput": {
                  "answer": "rotate it in the console"
                },
                "input": {
                  "question": "how do I reset my key?"
                },
                "status": "ACTIVE"
              },
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/evals/datasets": {
      "get": {
        "operationId": "listDatasets",
        "summary": "listDatasets returns the caller org's datasets.",
        "description": "listDatasets returns the caller org's datasets. Item counts are not computed here —\nread one dataset for its count.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned; 0 or below means the default and anything\nabove the maximum is clamped to it.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "createDataset",
        "summary": "createDataset registers a dataset in the caller's org and answers 201.",
        "description": "createDataset registers a dataset in the caller's org and answers 201. The name must\nbe a slug and unique within the org; a repeat upserts the description and metadata\nrather than duplicating the row.",
        "tags": [
          "evals"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "description": "Golden answers for support triage",
                "metadata": {
                  "owner": "support"
                },
                "name": "support-golden"
              },
              "schema": {
                "$ref": "#/components/schemas/DatasetInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/evals/datasets/{name}": {
      "delete": {
        "operationId": "deleteDataset",
        "summary": "deleteDataset removes one of the caller org's datasets and answers 204.",
        "description": "deleteDataset removes one of the caller org's datasets and answers 204. A dataset\nbelonging to another org reads as not found and is left untouched.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name is the dataset name from the path.",
            "schema": {
              "type": "string"
            },
            "example": "support-golden"
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      },
      "get": {
        "operationId": "getDataset",
        "summary": "getDataset returns one of the caller org's datasets with its live item count.",
        "description": "getDataset returns one of the caller org's datasets with its live item count. A\ndataset belonging to another org reads as not found.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name is the dataset name from the path.",
            "schema": {
              "type": "string"
            },
            "example": "support-golden"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/evals/evaluators": {
      "get": {
        "operationId": "listEvaluators",
        "summary": "listEvaluators returns the caller org's LLM-as-judge definitions.",
        "description": "listEvaluators returns the caller org's LLM-as-judge definitions.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned; 0 or below means the default and anything\nabove the maximum is clamped to it.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluatorList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "createEvaluator",
        "summary": "createEvaluator registers an LLM-as-judge in the caller's org, answering 201.",
        "description": "createEvaluator registers an LLM-as-judge in the caller's org, answering 201.\nAn evaluator is a judge model plus the rubric it scores against; a repeat with\nthe same name upserts.",
        "tags": [
          "evals"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "criteria": "Score 1 if the answer resolves the question, else 0.",
                "model": "zen5-pro",
                "name": "helpfulness",
                "scoreName": "helpfulness"
              },
              "schema": {
                "$ref": "#/components/schemas/EvaluatorInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluatorView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/evals/metrics": {
      "get": {
        "operationId": "evalMetrics",
        "summary": "metricsBoard serves the AI observability dashboard for the caller's org.",
        "description": "metricsBoard serves the AI observability dashboard for the caller's org. It\nreports request counts, cost, tokens, error and success rate, and latency\npercentiles over a window, bucketed and broken down by model. A validated\nSuperAdmin sees every org. Tenant\nisolation is the principal gate: no validated principal is a 403. When telemetry is\ndisabled, or the caller's project is a named sub-scope the ledger does not yet\nattribute, the board is honest-empty — a valid all-zero board, never a fabricated\nnumber and never a 503.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Range is a fixed window preset: 24h, 7d or 30d. Anything else means 24h.",
            "schema": {
              "type": "string"
            },
            "example": "7d"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Interval overrides the bucket: hour or day. Anything else keeps the\npreset's own bucket.",
            "schema": {
              "type": "string"
            },
            "example": "day"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/evals/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "listRuns returns the caller org's eval-run history.",
        "description": "listRuns returns the caller org's eval-run history. Each row carries what was\nscored, by which judge, and the mean over the items that actually scored. Read\nfrom the metastore, so it is available whether or not telemetry is wired.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "datasetName",
            "in": "query",
            "required": false,
            "description": "Dataset narrows to one dataset's runs.",
            "schema": {
              "type": "string"
            },
            "example": "support-golden"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned.",
            "schema": {
              "type": "integer"
            },
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_evals_runs",
        "tags": [
          "evals"
        ]
      }
    },
    "/v1/evals/score-configs": {
      "get": {
        "operationId": "listScoreConfigs",
        "summary": "listScoreConfigs returns the caller org's score configs — the rules every recorded",
        "description": "listScoreConfigs returns the caller org's score configs — the rules every recorded\nscore of that name is validated against.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned; 0 or below means the default and anything\nabove the maximum is clamped to it.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreConfigList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "createScoreConfig",
        "summary": "createScoreConfig declares what a score of this name may carry.",
        "description": "createScoreConfig declares what a score of this name may carry. That is its type\nplus its numeric bounds or its allowed labels, and it answers 201. Once a config\nexists it is AUTHORITATIVE: a later score of that name is validated against it and\ncannot claim a different type.",
        "tags": [
          "evals"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "dataType": "NUMERIC",
                "maxValue": 1,
                "minValue": 0,
                "name": "helpfulness"
              },
              "schema": {
                "$ref": "#/components/schemas/ScoreConfigInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreConfigView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/evals/scores": {
      "get": {
        "operationId": "listScores",
        "summary": "listScores returns the caller org's recorded scores, newest first.",
        "description": "listScores returns the caller org's recorded scores, newest first. The org is read\nfrom the validated principal, never a client header, so the filters narrow within\none tenant and can never widen past it. Requires telemetry.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Name narrows to one score name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runName",
            "in": "query",
            "required": false,
            "description": "RunName narrows to one eval run.",
            "schema": {
              "type": "string"
            },
            "example": "run-20260729T101500Z"
          },
          {
            "name": "traceId",
            "in": "query",
            "required": false,
            "description": "TraceID narrows to one trace.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned.",
            "schema": {
              "type": "integer"
            },
            "example": 100
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "createScore",
        "summary": "createScore records one score event against a trace, run or dataset item.",
        "description": "createScore records one score event against a trace, run or dataset item. It\nanswers 201. Score integrity is enforced here: the value must be finite, and when a\nscore config of this name exists it is authoritative — the value must sit inside its\nbounds, the label inside its category set, and a caller cannot claim a different\ntype than the org configured. Requires telemetry; without a datastore the score has\nnowhere durable to land, so the call fails closed rather than reporting a score it\ndid not store.",
        "tags": [
          "evals"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "comment": "resolved the question",
                "name": "helpfulness",
                "runName": "run-20260729T101500Z",
                "traceId": "tr_9f2a1c7d4e8b0a6f",
                "value": 1
              },
              "schema": {
                "$ref": "#/components/schemas/ScoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/evals/traces": {
      "get": {
        "operationId": "listTraces",
        "summary": "listTraces returns the caller org's traces, newest first.",
        "description": "listTraces returns the caller org's traces, newest first. Both tenant keys are\nserver-side: the org from the validated principal and the project from its minted\nscope, so a caller cannot read another tenant's or another project's traces.\nRequires telemetry.",
        "tags": [
          "evals"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "description": "SessionID narrows to one session.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runName",
            "in": "query",
            "required": false,
            "description": "RunName narrows to one eval run.",
            "schema": {
              "type": "string"
            },
            "example": "run-20260729T101500Z"
          },
          {
            "name": "datasetName",
            "in": "query",
            "required": false,
            "description": "Dataset narrows to the traces of one dataset's items.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Limit caps the rows returned.",
            "schema": {
              "type": "integer"
            },
            "example": 50
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceList"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    }
  },
