{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Generated from the live router — every operation below is a route the unified cloud binary actually serves. Tagged by product: the first path segment after /v1/.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "links"
    }
  ],
  "paths": {
    "/v1/links": {
      "get": {
        "operationId": "get_v1_links",
        "summary": "listLinks lists the caller's own account links, flat and grouped by device.",
        "description": "listLinks lists the caller's own account links, flat and grouped by device.\nIt answers only for the calling subject in the calling org — another user's\nlinks are never included.",
        "tags": [
          "links"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "devices": [],
                  "links": [
                    {
                      "billing": "plan",
                      "createdAt": "2026-07-29T11:00:00Z",
                      "host": "spark",
                      "id": "link_4c1e",
                      "kind": "subscription",
                      "machine": "m_7f31",
                      "provider": "anthropic",
                      "status": "linked",
                      "updatedAt": "2026-07-29T11:00:00Z",
                      "user": "z@hanzo.ai"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/linkList"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_links",
        "summary": "upsertLink registers or refreshes one machine's provider account for the caller.",
        "description": "upsertLink registers or refreshes one machine's provider account for the caller.\nMachine and provider identify the link, so reporting the same pair again updates\nthe existing row rather than adding a second one.",
        "tags": [
          "links"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "account": "z@hanzo.ai",
                "host": "spark",
                "kind": "subscription",
                "machine": "m_7f31",
                "os": "linux",
                "plan": "max",
                "provider": "anthropic"
              },
              "schema": {
                "$ref": "#/components/schemas/enrollReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/linkView"
                }
              }
            },
            "description": "created"
          }
        }
      }
    },
    "/v1/links/devices/{machine}": {
      "get": {
        "operationId": "get_v1_links_devices_machine",
        "summary": "deviceDetail reads one of the caller's devices: every provider account linked on",
        "description": "deviceDetail reads one of the caller's devices: every provider account linked on\nthat machine, plus how many sessions the caller currently runs there.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "machine",
            "in": "path",
            "required": true,
            "description": "Machine is the machine id from the path.",
            "schema": {
              "type": "string"
            },
            "example": "m_7f31"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/deviceView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/links/devices/{machine}/revoke": {
      "post": {
        "operationId": "post_v1_links_devices_machine_revoke",
        "summary": "revokeDevice revokes every account the caller linked on one machine.",
        "description": "revokeDevice revokes every account the caller linked on one machine. It stops the\nsessions they were running there and is the \"I lost this laptop\" verb, and other\nusers' links on the same machine are untouched.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "machine",
            "in": "path",
            "required": true,
            "description": "Machine is the machine id from the path.",
            "schema": {
              "type": "string"
            },
            "example": "m_7f31"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "machine": "m_7f31"
              },
              "schema": {
                "$ref": "#/components/schemas/deviceRef"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/revokeResp"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/links/route": {
      "get": {
        "operationId": "get_v1_links_route",
        "summary": "routePlan ranks the caller's linked accounts into a redundancy plan.",
        "description": "routePlan ranks the caller's linked accounts into a redundancy plan. It says which\none to send the next request to and what to fall back to: subscription accounts\ncome before metered API keys, and within a group the most headroom wins.",
        "tags": [
          "links"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "candidates": [
                    {
                      "available": true,
                      "billing": "plan",
                      "headroomPct": 53,
                      "kind": "subscription",
                      "linkId": "link_4c1e",
                      "provider": "anthropic"
                    }
                  ],
                  "generatedAt": "2026-07-29T11:00:00Z"
                },
                "schema": {
                  "$ref": "#/components/schemas/RoutePlan"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/links/usage": {
      "get": {
        "operationId": "get_v1_links_usage",
        "summary": "usageDash reports one connected account's consumption of its OWN provider plan.",
        "description": "usageDash reports one connected account's consumption of its OWN provider plan. It\nsays how far through the current window it is and when that resets: current is the\nlive state of each lane, windows is the history behind it, and available:false\nmeans the warehouse could not be read, which is not the same as no usage.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "Provider is the account's provider, e.g. anthropic or openai. Required.",
            "schema": {
              "type": "string"
            },
            "example": "anthropic"
          },
          {
            "name": "account",
            "in": "query",
            "required": false,
            "description": "Account narrows to one account of that provider; empty covers them all.",
            "schema": {
              "type": "string"
            },
            "example": "z@hanzo.ai"
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "Window narrows to one window class: 6h, day, week or month.",
            "schema": {
              "type": "string"
            },
            "example": "6h"
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Range is the history period to read, e.g. 24h; empty means 24h.",
            "schema": {
              "type": "string"
            },
            "example": "24h"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/planDash"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "post_v1_links_usage",
        "tags": [
          "links"
        ]
      }
    },
    "/v1/links/usage/accounts": {
      "get": {
        "operationId": "get_v1_links_usage_accounts",
        "summary": "usageAccounts breaks the caller's Hanzo-ROUTED usage down per linked account.",
        "description": "usageAccounts breaks the caller's Hanzo-ROUTED usage down per linked account.\nThis is what Hanzo itself served and charged for, not what a provider's own plan\nmetered; it answers only for the calling subject.",
        "tags": [
          "links"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "accounts": [],
                  "scope": "user",
                  "source": "routed",
                  "total": {
                    "accounts": 1,
                    "completionTokens": 9800,
                    "costCents": 316,
                    "promptTokens": 41200,
                    "requests": 128,
                    "totalTokens": 51000
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AccountsUsage"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/links/usage/summary": {
      "get": {
        "operationId": "get_v1_links_usage_summary",
        "summary": "usageSummary totals the caller's provider accounts beside their org's Hanzo usage.",
        "description": "usageSummary totals the caller's provider accounts beside their org's Hanzo usage.\nBoth sides land on one board for one period and each reports its own availability,\nso half a warehouse never turns the other half into zeros, and both resolve the\nSAME window from one resolver.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Range is the period to total over, e.g. 24h; empty means 24h.",
            "schema": {
              "type": "string"
            },
            "example": "24h"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/summaryResp"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/links/{id}": {
      "delete": {
        "operationId": "delete_v1_links_id",
        "summary": "revokeLink revokes one account link and stops the sessions running on it.",
        "description": "revokeLink revokes one account link and stops the sessions running on it. The row\nis kept and marked revoked so the history stays inspectable, and a link of another\nuser or org is reported not-found.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the link id from the path.",
            "schema": {
              "type": "string"
            },
            "example": "link_4c1e9b7a2d6f0538"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/revokeResp"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "get": {
        "operationId": "get_v1_links_id",
        "summary": "getLink reads one of the caller's own account links.",
        "description": "getLink reads one of the caller's own account links. A link belonging to another\nuser or org is reported not-found, so the id space leaks no existence.",
        "tags": [
          "links"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID is the link id from the path.",
            "schema": {
              "type": "string"
            },
            "example": "link_4c1e9b7a2d6f0538"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/linkView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    }
  },
