    "/v1/deploy/applications/{name}/revisions/{revision}/metadata": {
      "get": {
        "operationId": "get_v1_deploy_applications_name_revisions_revision_metadata",
        "summary": "revisionMetadata describes one revision of an application as far as the CR knows.\n\nThe App CR is IMAGE-based: the deploy is pinned to an image tag, not a git commit, and\nthe projection's git source (git.hanzo.ai/hanzoai/universe) is the display-only manifest\nrepo, NOT the app's own source — so there is no in-process commit to resolve a revision\nauthor/date/message from (clients/git exposes CloneURL + VerifyRef only, neither of which\nyields commit metadata for an arbitrary revision).",
        "description": "revisionMetadata describes one revision of an application as far as the CR knows.\n\nThe App CR is IMAGE-based: the deploy is pinned to an image tag, not a git commit, and\nthe projection's git source (git.hanzo.ai/hanzoai/universe) is the display-only manifest\nrepo, NOT the app's own source — so there is no in-process commit to resolve a revision\nauthor/date/message from (clients/git exposes CloneURL + VerifyRef only, neither of which\nyields commit metadata for an arbitrary revision). Rather than 404 (the toast) or\nfabricate a git author, this returns an HONEST minimal RevisionMetadata: message = the\nrevision (HEAD resolves to the CR's declared image tag), date = when the app was declared\n(the CR creation time), author = \"\" (none). Real git enrichment is a follow-on gated on\nthe CR carrying a real git source + a clients/git CommitMetadata export.",
        "tags": [
          "deploy"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name is the application name from the path; a DNS-1123 label.",
            "schema": {
              "type": "string"
            },
            "example": "cloud"
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "description": "Revision is the revision from the path; \"\" or \"HEAD\" resolves to the CR's tag.",
            "schema": {
              "type": "string"
            },
            "example": "HEAD"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/argoRevisionMetadata"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
