    "/v1/deploy/session/userinfo": {
      "get": {
        "operationId": "get_v1_deploy_session_userinfo",
        "summary": "userInfo reports whether this browser is signed in, and where to sign in if not.\nIt is the ONE route here that answers an anonymous caller, because a 403 to\nthat question is unanswerable for an XHR client.",
        "description": "userInfo reports whether this browser is signed in, and where to sign in if not.\nIt is the ONE route here that answers an anonymous caller, because a 403 to\nthat question is unanswerable for an XHR client. The predicate is the same\nSuperAdmin fact every other route gates on, so a validated-but-not-SuperAdmin\ncaller is reported as not logged in — the truth as this console defines it.",
        "tags": [
          "deploy"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "groups": [],
                  "iss": "argocd",
                  "loggedIn": true,
                  "logoutUrl": "/v1/deploy/logout",
                  "username": "z"
                },
                "schema": {
                  "$ref": "#/components/schemas/userInfoView"
                }
              }
            },
            "description": "ok"
          }
        }
