    "/v1/deploy/applications": {
      "get": {
        "operationId": "get_v1_deploy_applications",
        "summary": "applications lists the caller's applications, projected from the operator App CRs.\nA SuperAdmin sees the whole fleet; a validated org member sees only its own\norg's apps.",
        "description": "applications lists the caller's applications, projected from the operator App CRs.\nA SuperAdmin sees the whole fleet; a validated org member sees only its own\norg's apps. Nothing is read from a stored argocd Application — every item is\nsynthesized from the App CR that actually runs.",
        "tags": [
          "deploy"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/argoAppList"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/deploy/applications/{name}": {
      "get": {
        "operationId": "get_v1_deploy_applications_name",
        "summary": "application returns one projected application, with its reconciled resources.",
        "description": "application returns one projected application, with its reconciled resources.\nA name another org owns is reported as not found, never as forbidden, so the\ndetail route leaks no cross-tenant existence oracle.",
        "tags": [
          "deploy"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name is the application name from the path; a DNS-1123 label.",
            "schema": {
              "type": "string"
