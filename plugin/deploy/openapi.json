    "/v1/deploy/reconcile": {
      "post": {
        "operationId": "post_v1_deploy_reconcile",
        "summary": "reconcile renders the configured git source and applies it to the cluster once.\nIt is the SuperAdmin-gated write half that replaces universe-crs: a three-way\nserver-side apply through the embedded gitops-engine, with a scoped prune and\nper-resource health.",
        "description": "reconcile renders the configured git source and applies it to the cluster once.\nIt is the SuperAdmin-gated write half that replaces universe-crs: a three-way\nserver-side apply through the embedded gitops-engine, with a scoped prune and\nper-resource health. Disabled unless DEPLOY_ENGINE_ENABLED is set.",
        "tags": [
          "deploy"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reconcileView"
