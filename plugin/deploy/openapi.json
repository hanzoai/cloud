    "/v1/deploy/logout": {
      "post": {
        "operationId": "post_v1_deploy_logout",
        "summary": "logout clears the session cookie for this host.",
        "description": "logout clears the session cookie for this host. IAM's own session is untouched —\nthis ends the console session only.\n\nIt is a POST because it CHANGES STATE. As a GET it was reachable by a cross-site\ntop-level navigation (an \u003cimg\u003e or a link on any page), which a SameSite=Lax cookie\nstill rides, so any site could sign a SuperAdmin out at will. A nuisance rather\nthan a compromise, but a state-changing GET is a bug regardless; POST is not\ncarried cross-site by a Lax cookie, so the class is closed.\nlogout clears the console session cookie and reports the caller signed out.\nPOST, not GET: signing out changes state, and a state-changing GET is reachable\nby a cross-site top-level navigation a SameSite=Lax cookie still rides.",
        "tags": [
          "deploy"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "loggedIn": false,
                  "loginUrl": "/v1/deploy/login"
                },
                "schema": {
                  "$ref": "#/components/schemas/userInfoView"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/deploy/projects": {
      "get": {
        "operationId": "get_v1_deploy_projects",
        "summary": "projects lists the caller's IAM projects, reflected read-only as AppProjects.\nIAM is the one source of truth for the (org, name) Project resource: a normal\norg sees only its own organization's projects, a SuperAdmin every org's, and\n\"default\" always resolves.",
        "description": "projects lists the caller's IAM projects, reflected read-only as AppProjects.\nIAM is the one source of truth for the (org, name) Project resource: a normal\norg sees only its own organization's projects, a SuperAdmin every org's, and\n\"default\" always resolves. When the embedded IAM store is unreachable a\nSuperAdmin still sees real argoproj.io/v1alpha1 AppProject CRs if that CRD is\nserved, else one permissive project per distinct App-CR project name.",
        "tags": [
          "deploy"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/argoProjectList"
