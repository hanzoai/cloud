{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Package experiments is cloud's unified EXPERIMENT primitive: A/B testing as ONE value whatever the variant KIND is — a feature flag, an ad creative, an email subject, a model id.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "experiments"
    }
  ],
  "paths": {
