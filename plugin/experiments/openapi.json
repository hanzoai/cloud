          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/experiments/{id}/assign": {
      "get": {
        "operationId": "get_v1_experiments_by_id_assign",
        "tags": [
          "experiments"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/experiments/{id}/decide": {
      "post": {
        "operationId": "post_v1_experiments_by_id_decide",
        "tags": [
          "experiments"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
