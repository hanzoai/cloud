      "get": {
        "operationId": "get_v1_experiments",
        "tags": [
          "experiments"
        ]
      },
      "post": {
        "operationId": "post_v1_experiments",
        "tags": [
          "experiments"
        ]
      }
    },
    "/v1/experiments/health": {
      "get": {
        "operationId": "get_v1_experiments_health",
        "tags": [
          "experiments"
        ]
      }
    },
    "/v1/experiments/{id}": {
      "get": {
        "operationId": "get_v1_experiments_by_id",
        "tags": [
          "experiments"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/experiments/{id}/analyze": {
      "post": {
        "operationId": "post_v1_experiments_by_id_analyze",
