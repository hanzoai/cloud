  "paths": {
    "/v1/builds": {
      "get": {
        "operationId": "get_v1_builds",
        "summary": "listBuilds returns the org's recorded BuildKit builds, newest first.",
        "description": "listBuilds returns the org's recorded BuildKit builds, newest first.\nEach row is joined to its app for the source repo and to its deployment for\nthe commit.\nA build is triggered by deploying a git-source app — the ONE build trigger —\nso this is list-only, and an org that has built nothing gets an empty list\nrather than a fabricated one.",
        "tags": [
          "builds"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/buildList"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/environments": {
      "get": {
        "operationId": "get_v1_environments",
        "summary": "listEnvironments aggregates the org's apps into their deploy targets.",
        "description": "listEnvironments aggregates the org's apps into their deploy targets.\nAn environment is not a standalone record — it is the Application.Environment\nscope — so this is list-only, and a new environment appears the moment an app\ntargets it.",
        "tags": [
          "environments"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/environmentList"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/pipelines": {
      "get": {
        "operationId": "get_v1_pipelines",
        "summary": "listPipelines projects each of the org's apps as a CI/CD pipeline.",
        "description": "listPipelines projects each of the org's apps as a CI/CD pipeline.\nA row carries the app's build source (repo or image) and the status and timing\nof its latest deployment run.\nThere is one pipeline per app — a pipeline is created by creating an app — so\nthis is list-only.",
        "tags": [
          "pipelines"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pipelineList"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
