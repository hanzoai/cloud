    "/v1/releases": {
      "get": {
        "operationId": "get_v1_releases",
        "summary": "listReleases returns the org's released versions.",
        "description": "listReleases returns the org's released versions.\nA release is a deployment that actually reached the cluster (deploying or\nlive), so a build that never rolled out is not one.\nReleases are created by deploying — the ONE deploy path — so this is\nlist-only, and it reports real deployment history and nothing else.",
        "tags": [
          "releases"
        ],
        "responses": {
          "200": {
            "content": {
