{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanzo Cloud API",
    "description": "Package base is managed Hanzo Base: a hosted backend for your app — collections, records, access rules and sign-in.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.hanzo.ai"
    }
  ],
  "tags": [
    {
      "name": "base"
    },
    {
      "name": "collections"
    }
  ],
  "paths": {
    "/v1/base/health": {
      "get": {
        "operationId": "get_v1_base_health",
        "summary": "BaseHealth reports that the base subsystem is serving.",
        "description": "BaseHealth reports that the base subsystem is serving.\n\nIt is deliberately INDEPENDENT of whether this deployment actually embeds the\nBase engine: the route answers before the CLOUD_BASE_EMBED gate and before the\n/v1/base/* wildcard, so a liveness probe measures the process rather than an\noptional feature, and the wildcard can never shadow it. It reads no tenant, so a\nprober that sends no principal is answered rather than refused.",
        "tags": [
          "base"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/baseHealth"
                }
              }
            },
            "description": "ok"
          }
        }
      }
    },
    "/v1/collections": {
      "delete": {
        "operationId": "delete_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "get": {
        "operationId": "get_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "options": {
        "operationId": "options_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "patch": {
        "operationId": "patch_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "post": {
        "operationId": "post_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "put": {
        "operationId": "put_v1_collections",
        "tags": [
          "collections"
        ]
      },
      "trace": {
        "operationId": "trace_v1_collections",
        "tags": [
          "collections"
        ]
      }
    },
    "/v1/collections/{wildcard1}": {
      "delete": {
        "operationId": "delete_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "get": {
        "operationId": "get_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "options": {
        "operationId": "options_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "operationId": "patch_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "post_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "operationId": "put_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "trace": {
        "operationId": "trace_v1_collections_by_wildcard1",
        "tags": [
          "collections"
        ],
        "parameters": [
          {
            "name": "wildcard1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "baseHealth": {
        "properties": {
          "service": {
            "description": "Service is \"base\" — which subsystem answered.",
            "type": "string"
          },
          "status": {
            "description": "Status is \"ok\" when the subsystem is serving.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
